generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model NBAConferenceStandings {
  TEAM String
  WIN Int
  LOSS Int
  percentage Double
  GAMES_BACK Int
  STREAK String?
}

model nbaPowerRankings {
  
}
